# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edenverse"
DATABASE_URL_UNPOOLED=""

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Admin setup (one-time use, remove after first admin is created) ─────────
# Generate with: openssl rand -hex 24
ADMIN_SETUP_TOKEN="replace-this-with-a-one-time-random-token"
# Key to access the Eden Vault admin dashboard
ADMIN_ACCESS_KEY="replace-this-with-a-private-admin-vault-key"

# ─── Public site config ──────────────────────────────────────────────────────
# Optional: custom default hero intro before admin changes are saved.
NEXT_PUBLIC_SITE_INTRO=""
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/zKpzsdzaf2"

# ─── Captcha (Cloudflare Turnstile) ─────────────────────────────────────────
# Set NEXT_PUBLIC_CAPTCHA_ENABLED="true" and fill both keys to enable captcha.
NEXT_PUBLIC_CAPTCHA_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── File uploads ────────────────────────────────────────────────────────────
# Directory relative to project root where uploaded images are saved.
UPLOAD_DIR="public/uploads"
# Set to "true" only if you want to allow local file uploads in production.
# Recommended: keep "false" in production and use external CDN URLs instead.
ENABLE_LOCAL_UPLOADS="false"

# ─── Demo mode (local development only, never set in production) ─────────────
ENABLE_PRISMA_DEMO_FALLBACK="false"
ENABLE_DEMO_AUTH="false"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
